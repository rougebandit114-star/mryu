{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string" },
        "joined": { "type": "string" },
        "country": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "type", "date"]
    },
    "Budget": {
      "title": "Budget",
      "description": "User monthly budget setup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "month": { "type": "string" },
        "year": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "amount", "month", "year"]
    }
  },
  "firestore": {
    "profiles/{userId}": {
      "schema": "Profile",
      "description": "Collection of user profiles"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Collection of all transactions"
    },
    "budgets/{budgetId}": {
      "schema": "Budget",
      "description": "Collection of monthly budgets mapped by budget ID (userId_month_year)"
    }
  }
}
